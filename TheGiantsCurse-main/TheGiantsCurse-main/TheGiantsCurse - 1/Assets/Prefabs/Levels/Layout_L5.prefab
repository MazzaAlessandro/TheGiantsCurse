    - target: {fileID: 3542944276342434931, guid: b1827a3555d0aa948b34e5bf7e99ff2f, type: 3}
      propertyPath: writtenOnSign.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3542944276342434931, guid: b1827a3555d0aa948b34e5bf7e99ff2f, type: 3}
      propertyPath: writtenOnSign.Array.data[0]
      value: Brick walls can be destroyed by an explosion or by hitting them enough
        time with a pickaxe, so if you don't have one find an explosive barrel, pick
        it up and throw it!
      objectReference: {fileID: 0}
    - target: {fileID: 3542944276342434931, guid: b1827a3555d0aa948b34e5bf7e99ff2f, type: 3}
      propertyPath: writtenOnSign.Array.data[1]
      value: "Interact with a lever to open a door, but look out, it will close on
        its own after a couple of seconds!\r"
      objectReference: {fileID: 0}
    - target: {fileID: 3542944276342434931, guid: b1827a3555d0aa948b34e5bf7e99ff2f, type: 3}
      propertyPath: writtenOnSign.Array.data[2]
      value: Interact with a crate to get a rope! Your next arrow can be used to
        pull yourself towards columns without worrying of falling down.
      objectReference: {fileID: 0}
    - target: {fileID: 3542944276342434931, guid: b1827a3555d0aa948b34e5bf7e99ff2f, type: 3}
      propertyPath: writtenOnSign.Array.data[3]
      value: There's an Hazard Globe in this room! Pick it up to slow down the other
        players!
      objectReference: {fileID: 0}
    - target: {fileID: 3542944276342434942, guid: b1827a3555d0aa948b34e5bf7e99ff2f, type: 3}
      propertyPath: m_Name
      value: Signpost
      objectReference: {fileID: 0}
